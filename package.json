{
  "name": "gleam-card",
  "version": "0.0.11",
  "private": true,
  "type": "module",
  "license": "Unlicense",
  "author": "Magnus Øverli <magnus@overli.dev>",
  "packageManager": "npm@12.2.3",
  "engines": {
    "node": ">=26.13.1"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:test": "npm run build && vite --host 127.0.0.1 --mode test",
    "deploy": "npm run build && node scripts/deploy.js",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "benchmark": "playwright test performance.spec.js --project=desktop --workers=1"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/three": "0.187.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
